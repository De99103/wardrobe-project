{
  "manifest_version": 3,
  "name": "Wearly – Import Product",
  "version": "0.1.0",
  "description": "Import the product you are viewing into Wearly.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {"default_popup": "popup.html", "default_title": "Add to Wearly"}
}
