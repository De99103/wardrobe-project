# Required for AI features. Copy the Firebase web API key used by the frontend.
# Set this on the backend hosting project too, then redeploy after changing it.
FIREBASE_WEB_API_KEY=

GROQ_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: enables hosted retrieval when a direct store link cannot be read.
# Server-only credential; never use an EXPO_PUBLIC variable.
FIRECRAWL_API_KEY=

# Preferred blocked-page reader. Public store URLs only; keep this server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
WEATHER_API_KEY=
CORS_ORIGINS=https://your-frontend.vercel.app
