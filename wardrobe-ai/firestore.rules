rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['uid','displayName','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','displayName','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }
    match /users/{uid}/clothing/{itemId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function nullableText(value) { return value == null || (value is string && value.size() <= 2000); }
      function validImage(value) {
        return value == null || (value is string && (
          (value.size() <= 2000 && value.matches('https://.*')) ||
          (value.size() <= 300023 && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}'))
        ));
      }
      function validItem() {
        let d = request.resource.data;
        return d.keys().hasAll(['name','brand','category','subcategory','color','material','price','currency','imageUrl','sourceUrl','status','savedAt'])
          && d.keys().hasOnly(['name','brand','category','subcategory','color','material','price','currency','imageUrl','sourceUrl','status','savedAt'])
          && d.status in ['owned','wishlist'] && d.savedAt is string && d.savedAt.size() <= 40
          && d.sourceUrl is string && d.sourceUrl.size() <= 2048 && (d.sourceUrl.matches('https://.*') || (d.sourceUrl.matches('manual:[0-9a-fA-F-]{36}') && d.category in ['tops','bottoms','dresses','outerwear','shoes','accessories','uncategorized']))
          && (d.price == null || (d.price is number && d.price >= 0))
          && nullableText(d.name) && nullableText(d.brand) && nullableText(d.category)
          && nullableText(d.subcategory) && nullableText(d.color) && nullableText(d.material)
          && nullableText(d.currency) && validImage(d.imageUrl);
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validItem();
    }
  }
}
